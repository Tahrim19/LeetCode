class Solution {
    public int[] twoSum(int[] nums, int target) {
        // BRUTE FORCE METHOD. OPTIMAL METHOD IS USING HASHMAP
        int len = nums.length;
        for(int i=0 ; i<len; i++){
            for(int j=i+1; j<len; j++){
                if(nums[i] + nums[j] == target){
                    return new int[]{i,j};
                }
            }
        }
        return new int[]{};
    }
    
}